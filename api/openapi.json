{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Go Shop",
    "version": "1.0.0",
    "description": "Local single-process reference backend. No authentication or persistence. Bind to loopback. Inventory, order, and idempotency updates commit atomically. Identifiers are case sensitive. POST order keys are scoped globally to this demo process, retained until restart, and recorded only on success. A retry with the same key and canonical payload returns the original 201 body; a different payload returns 409. Reordering items is equivalent; duplicate SKUs are rejected. Error responses contain a server-generated request ID. Unsupported methods return 405 with Allow; unknown routes return 404. Business requests must not include duplicate JSON keys; clients must send unique field names."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local demo"
    }
  ],
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Process liveness (not dependency readiness)",
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/inventory/{sku}": {
      "get": {
        "operationId": "getStock",
        "summary": "Read available and reserved stock",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stock snapshot",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stock"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource or SKU not found",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request interrupted; retry POST /v1/orders with the same key",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order and reserve every item atomically",
        "description": "Body limit 16384 bytes. JSON unknown fields and trailing values are rejected. Failed attempts do not consume their idempotency key. All-or-nothing reservation.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              },
              "example": {
                "customer_id": "customer-001",
                "items": [
                  {
                    "sku": "SKU-001",
                    "quantity": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created, or exact original successful response replayed (including after cancellation).",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              },
              "Location": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^/v1/orders/ord_[a-f0-9]{32}$"
                }
              },
              "Idempotency-Replayed": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource or SKU not found",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Insufficient stock or idempotency conflict",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16384 bytes",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request interrupted; retry POST /v1/orders with the same key",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Read current order state",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current order",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource or SKU not found",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request interrupted; retry POST /v1/orders with the same key",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{id}/cancel": {
      "post": {
        "operationId": "cancelOrder",
        "summary": "Cancel an order and release stock exactly once",
        "description": "No request body. Repeated cancellation returns the same cancelled order without changing stock or timestamps.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled order",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource or SKU not found",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request interrupted; retry POST /v1/orders with the same key",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "$ref": "#/components/schemas/Identifier"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "sku",
          "quantity"
        ]
      },
      "Identifier": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "maxLength": 64
      },
      "CreateOrder": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "description": "SKU must be unique. Item order does not affect idempotency."
          }
        },
        "required": [
          "customer_id",
          "items"
        ]
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "customer_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "reserved",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "customer_id",
          "items",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "Stock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "$ref": "#/components/schemas/Identifier"
          },
          "available": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "reserved": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "sku",
          "available",
          "reserved"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_input",
                  "not_found",
                  "insufficient_stock",
                  "idempotency_conflict",
                  "body_too_large",
                  "unsupported_media_type",
                  "method_not_allowed",
                  "unavailable",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "request_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
