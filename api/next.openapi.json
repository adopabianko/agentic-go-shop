  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "$ref": "#/components/schemas/Identifier"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "sku",
          "quantity"
        ]
      },
      "Identifier": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "maxLength": 64
      },
      "CreateOrder": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "description": "SKU must be unique. Item order does not affect idempotency."
          }
        },
        "required": [
          "customer_id",
          "items"
        ]
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "customer_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "reserved",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "customer_id",
          "items",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "Stock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "$ref": "#/components/schemas/Identifier"
          },
          "available": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "reserved": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "sku",
          "available",
          "reserved"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_input",
                  "not_found",
                  "insufficient_stock",
                  "idempotency_conflict",
                  "body_too_large",
                  "unsupported_media_type",
                  "method_not_allowed",
                  "unavailable",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "request_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AdjustmentInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[ -~]+$"
          }
        },
        "required": [
          "quantity",
          "reason"
        ]
      },
      "Adjustment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^adj_[a-f0-9]{32}$"
          },
          "sku": {
            "$ref": "#/components/schemas/Identifier"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[ -~]+$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sku",
          "quantity",
          "reason",
          "created_at"
        ]
      },
      "OrderPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "next_cursor": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      }
    }
  }
}
