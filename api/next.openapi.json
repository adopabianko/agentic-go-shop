{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Go Shop \u2014 NEXT SPRINT DRAFT",
    "version": "1.1.0-draft",
    "description": "Local single-process reference backend. No authentication or persistence. Bind to loopback. Inventory, order, and idempotency updates commit atomically. Identifiers are case sensitive. POST order keys are scoped globally to this demo process, retained until restart, and recorded only on success. A retry with the same key and canonical payload returns the original 201 body; a different payload returns 409. Reordering items is equivalent; duplicate SKUs are rejected. Error responses contain a server-generated request ID. Unsupported methods return 405 with Allow; unknown routes return 404. Business requests must not include duplicate JSON keys; clients must send unique field names. DRAFT: adjustment and pagination operations below are NOT implemented in the baseline."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local demo"
    }
  ],
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Process liveness (not dependency readiness)",
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
