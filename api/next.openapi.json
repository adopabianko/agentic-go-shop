    "/v1/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order and reserve every item atomically",
        "description": "Body limit 16384 bytes. JSON unknown fields and trailing values are rejected. Failed attempts do not consume their idempotency key. All-or-nothing reservation.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              },
              "example": {
                "customer_id": "customer-001",
                "items": [
                  {
                    "sku": "SKU-001",
                    "quantity": 2
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created, or exact original successful response replayed (including after cancellation).",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              },
              "Location": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^/v1/orders/ord_[a-f0-9]{32}$"
                }
              },
              "Idempotency-Replayed": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource or SKU not found",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Insufficient stock or idempotency conflict",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16384 bytes",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request interrupted; retry POST /v1/orders with the same key",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listOrders",
        "summary": "DRAFT \u2014 list orders by ascending (created_at,id)",
        "description": "No snapshot guarantee across pages. Reject unknown or duplicated query parameters and explicitly empty values. Cursor binds customer_id. No total count. Empty items is [], not null.",
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048,
              "minLength": 1
            }
          }
        ],
        "responses": {
