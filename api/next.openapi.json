    "/v1/inventory/{sku}/adjustments": {
      "post": {
        "operationId": "adjustStock",
        "summary": "DRAFT \u2014 add positive stock atomically",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdjustmentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Original receipt, including on replay. Quantity is added only once. No Location header: receipt retrieval is not a v1.1 operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Adjustment"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
